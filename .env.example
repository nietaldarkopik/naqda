# Salin ke .env lalu sesuaikan. Semua nilai di sini adalah contoh untuk pengembangan lokal.
# Tidak ada nilai yang bergantung pada Docker: bawaannya 127.0.0.1.

NODE_ENV=development

# --- Database (MySQL 8.4) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:@127.0.0.1:3306/naqdi
# Database terpisah untuk tes otomatis (dihapus dan dibuat ulang oleh tes)
TEST_DATABASE_URL=mysql://root:@127.0.0.1:3306/naqdi_test

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Asal web yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WAJIB diganti di produksi (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Web ---
WEB_URL=http://localhost:3000
# Alamat API yang dipanggil server Next (browser memakai /api/v1 pada asal yang sama)
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Antrean kerja: db (default, tanpa Redis) atau redis ---
QUEUE_DRIVER=db
# REDIS_URL=redis://127.0.0.1:6379

# --- Penyimpanan berkas: local atau s3 ---
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# --- Email (opsional; tanpa ini email ditulis ke outbox saja) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Email keluar. Tanpa SMTP_HOST, email hanya dicatat (tidak terkirim). Lihat docs/07-platform-saas.md bagian 5c.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_PASS = sandi aplikasi (App Password), bukan sandi akun.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Naqdi <no-reply@localhost>
MAIL_REPLY_TO=
OPERATOR_EMAIL=
APP_URL=http://localhost:3000
# Petunjuk transfer di faktur (rekening resmi). Pakai \n untuk baris baru.
BILLING_BANK_INFO=
