{
  "name": "naqdi",
  "private": true,
  "version": "0.0.0",
  "description": "Naqdi: aplikasi kasir (POS) multi-outlet, web, desktop, dan mobile",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/restore-check.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "start:api": "tsx apps/api/src/server.ts",
    "build": "npm run typecheck && npm --prefix apps/web run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "mobile:sync": "npm --prefix apps/mobile run sync",
    "mobile:open": "npm --prefix apps/mobile run open",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:seed": "tsx packages/db/src/cli/seed.ts",
    "docs:tax-examples": "tsx scripts/tax-examples.ts",
    "db:create-business": "tsx packages/db/src/cli/create-business.ts",
    "platform:create-admin": "tsx packages/db/src/cli/create-platform-admin.ts",
    "db:reset": "tsx packages/db/src/cli/reset.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
