# OPSIONAL dan BELUM DIUJI (lihat docker-compose.yml).
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.base.json tsconfig.json drizzle.config.ts ./
COPY packages ./packages
COPY apps/api ./apps/api
ENV NODE_ENV=production
EXPOSE 4000
# Migrasi dijalankan saat start (idempoten), lalu server API.
CMD ["sh", "-c", "npx tsx packages/db/src/cli/migrate.ts && npx tsx apps/api/src/server.ts"]
